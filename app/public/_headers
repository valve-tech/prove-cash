# Security headers for every page and asset. Cloudflare's static-asset server reads this file
# from the root of the assets directory (dist/, copied from public/ by Vite).
#
# connect-src allows any https: and wss: origin, not a fixed list. The endpoints dialog lets a
# reader point the app at their own RPC node, and a fixed list would break that setting in
# silence. The script policy carries the protection: only this origin's scripts run, no inline
# script, no eval. 'wasm-unsafe-eval' is for the proof-of-work engine in the grind worker.
# static.cloudflareinsights.com is Cloudflare Web Analytics. The edge injects its beacon script,
# and the owner chose to keep analytics (2026-09-29). Its reports go out under connect-src https:.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://gib.show; font-src 'self'; connect-src 'self' https: wss:; frame-src https://verify.walletconnect.org https://verify.walletconnect.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=()
  X-Frame-Options: DENY

# Vite names every file here by a hash of its content, so a file at one URL never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
