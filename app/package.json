{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/prerender.ts",
    "prerender": "tsx scripts/prerender.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:bots": "esbuild scripts/heartbeat.ts scripts/watchdog.ts scripts/market-mover.ts scripts/executor.ts scripts/solver.ts --bundle --platform=node --target=node20 --format=esm --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --outdir=dist-bots --out-extension:.js=.mjs",
    "gen:gas": "node scripts/gen-gas.mjs",
    "gen:prices": "node scripts/gen-prices.mjs",
    "check:gas": "node scripts/gen-gas.mjs --check",
    "check:addresses": "tsx scripts/check-addresses.ts",
    "check:fee-configs": "tsx scripts/check-fee-configs.ts",
    "check:opcodes": "tsx scripts/check-opcodes.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "i18n:status": "tsx scripts/i18n/status.ts",
    "i18n:review": "tsx scripts/i18n/review.ts"
  },
  "dependencies": {
    "@msgboard/sdk": "^0.4.0",
    "@prove.cash/sdk": "file:../sdk",
    "@walletconnect/universal-provider": "^2.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.3.0",
    "uqr": "^0.1.3",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^21.0.3",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.140.0"
  }
}
