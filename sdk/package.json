{
  "name": "@prove.cash/sdk",
  "version": "0.1.0",
  "description": "The prove.cash protocol client: signed swap intents, the msgboard wire codec, and settlement on PulseChain.",
  "license": "Unlicense",
  "repository": "github:valve-tech/prove-cash",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./abi": {
      "types": "./dist/abi.d.ts",
      "default": "./dist/abi.js"
    },
    "./archive": {
      "types": "./dist/archive.d.ts",
      "default": "./dist/archive.js"
    },
    "./board": {
      "types": "./dist/board.d.ts",
      "default": "./dist/board.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./deployed": {
      "types": "./dist/deployed.d.ts",
      "default": "./dist/deployed.js"
    },
    "./custody": {
      "types": "./dist/custody.d.ts",
      "default": "./dist/custody.js"
    },
    "./dryrun": {
      "types": "./dist/dryrun.d.ts",
      "default": "./dist/dryrun.js"
    },
    "./intent": {
      "types": "./dist/intent.d.ts",
      "default": "./dist/intent.js"
    },
    "./keepalive": {
      "types": "./dist/keepalive.d.ts",
      "default": "./dist/keepalive.js"
    },
    "./kv": {
      "types": "./dist/kv.d.ts",
      "default": "./dist/kv.js"
    },
    "./market": {
      "types": "./dist/market.d.ts",
      "default": "./dist/market.js"
    },
    "./multicall": {
      "types": "./dist/multicall.d.ts",
      "default": "./dist/multicall.js"
    },
    "./revert": {
      "types": "./dist/revert.d.ts",
      "default": "./dist/revert.js"
    },
    "./rfq": {
      "types": "./dist/rfq.d.ts",
      "default": "./dist/rfq.js"
    },
    "./rfq-crypto": {
      "types": "./dist/rfq-crypto.d.ts",
      "default": "./dist/rfq-crypto.js"
    },
    "./settlement": {
      "types": "./dist/settlement.d.ts",
      "default": "./dist/settlement.js"
    },
    "./solver": {
      "types": "./dist/solver/index.d.ts",
      "default": "./dist/solver/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    },
    "./submit": {
      "types": "./dist/submit.d.ts",
      "default": "./dist/submit.js"
    },
    "./tokenlist": {
      "types": "./dist/tokenlist.d.ts",
      "default": "./dist/tokenlist.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "gen:abi": "node scripts/gen-abi.mjs",
    "check:abi": "node scripts/gen-abi.mjs --check",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@msgboard/sdk": "^0.4.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^1.8.0"
  },
  "peerDependencies": {
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "oxlint": "^1.82.0",
    "typescript": "~7.0.2",
    "viem": "^2.56.8",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
